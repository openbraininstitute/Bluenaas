ARG UV_VERSION=0.8
ARG PYTHON_VERSION=3.12.14
ARG PYTHON_BASE=${PYTHON_VERSION}-slim

# uv stage
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

# build stage
FROM python:$PYTHON_BASE AS builder
SHELL ["bash", "-e", "-x", "-o", "pipefail", "-c"]

COPY --from=uv /uv /usr/local/bin/uv

ENV UV_LINK_MODE=copy \
  UV_COMPILE_BYTECODE=1 \
  UV_PYTHON_DOWNLOADS=never \
  UV_PYTHON=python${PYTHON_VERSION} \
  UV_INDEX_CODEARTIFACT_USERNAME=aws

WORKDIR /app

# TODO: remove what's not needed
RUN apt-get update \
  && apt-get install -q -y --no-install-recommends build-essential mpich libmpich-dev \
  && rm -rf /var/lib/apt/lists/*

ARG ENVIRONMENT
RUN --mount=type=cache,target=/root/.cache/uv \
  --mount=type=secret,id=CODEARTIFACT_TOKEN,env=UV_INDEX_CODEARTIFACT_PASSWORD,required=true \
  --mount=type=bind,source=uv.lock,target=uv.lock \
  --mount=type=bind,source=pyproject.toml,target=pyproject.toml <<EOT
set -e
# The length is tested instead of the value, to keep the token out of the traced build log
if [[ ${#UV_INDEX_CODEARTIFACT_PASSWORD} -eq 0 ]]; then
  echo "CODEARTIFACT_TOKEN build secret is missing or empty, see README (make codeartifact-env)" >&2
  exit 1
fi

if [ "${ENVIRONMENT}" = "prod" ]; then
  uv sync --locked --no-install-project --no-dev --group worker
elif [ "${ENVIRONMENT}" = "dev" ]; then
  uv sync --locked --no-install-project --group worker
else
  echo "Invalid ENVIRONMENT"; exit 1
fi

EOT

# run stage
FROM python:$PYTHON_BASE
SHELL ["bash", "-e", "-x", "-o", "pipefail", "-c"]

# TODO: remove what's not needed
RUN apt-get update \
  && apt-get install -q -y --no-install-recommends build-essential mpich libmpich-dev libhdf5-dev \
  && rm -rf /var/lib/apt/lists/*

ARG HOST_UID=1000
ARG HOST_GID=1000

RUN <<EOT
  groupadd --system --gid ${HOST_GID} --force app
  useradd --system --home-dir /app --uid ${HOST_UID} --gid ${HOST_GID} app
EOT

USER app
WORKDIR /app

RUN mkdir -p /app/storage

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH="/app"

# TODO: Double check if this is needed
ENV HDF5_USE_FILE_LOCKING=FALSE

# Skeletonized morphologies are more complex and require higher values for the params below
# compared to the NEURON defaults. -nogui silences NEURON's GUI/DISPLAY warning, which now
# also appears during mechanism compilation at model init.
ENV NEURON_MODULE_OPTIONS="-nogui -NSTACK 100000 -NFRAME 10000"

# When a model ships a mechanism that BlueCelluLab also bundles (TTXDynamicsSwitch,
# vecevent, ...), keep the model's copy: bundled MODs only fill in the missing ones.
ENV BLUECELLULAB_MOD_PRECEDENCE=circuit

COPY --chown=app:app --from=builder /app/.venv/ .venv
COPY --chown=app:app docker-worker-cmd.sh ./docker-cmd.sh
COPY --chown=app:app app/ ./app

RUN python -m compileall .

STOPSIGNAL SIGINT

CMD ["./docker-cmd.sh"]
